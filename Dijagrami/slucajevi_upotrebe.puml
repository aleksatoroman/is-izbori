@startuml slucajevi_upotrebe
!pragma layout smetana
left to right direction
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam usecase {
  BackgroundColor #DAE8FC
  BorderColor #6C8EBF
}
skinparam rectangle {
  BorderColor #444444
}

actor "Administrator" as Admin
actor "Student" as Student
actor "Izborna komisija" as Komisija

rectangle "IS za organizaciju i sprovođenje studentskih izbora" {
  usecase "Kreiranje izbora" as UC1
  usecase "Upravljanje biračkim spiskom" as UC2
  usecase "Upravljanje izbornim listama" as UC3
  usecase "Pregled informacija o izborima" as UC4
  usecase "Elektronsko glasanje" as UC5
  usecase "Pregled rezultata" as UC6
  usecase "Praćenje izlaznosti" as UC7
  usecase "Pregled rezultata\n(izborna komisija)" as UC8
  usecase "Objavljivanje rezultata" as UC9
  usecase "Objavljivanje obaveštenja\no ponavljanju izbora" as UC10
}

Admin --> UC1
Admin --> UC2
Admin --> UC3

Student --> UC4
Student --> UC5
Student --> UC6

UC7 <-- Komisija
UC8 <-- Komisija
UC9 <-- Komisija
UC10 <-- Komisija

UC9 ..> UC8 : <<include>>
UC10 ..> UC8 : <<include>>
@enduml
